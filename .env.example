# PostQron — modello di configurazione per lo sviluppo locale.
#
# Copia questo file in `.env` (ignorato da git) e adatta i valori:
#
#     cp .env.example .env
#
# Questo file è VERSIONATO: non inserirci mai credenziali reali. I segreti di
# produzione non stanno nel repository (SPEC §5).

# ------------------------------------------------------------------ database

# Nome del database, utente e password creati al primo avvio del container.
# Cambiarli dopo il primo `make db-up` non ha effetto: initdb gira una sola
# volta: per ripartire da zero serve `docker compose down -v`.
POSTGRES_DB=postqron
POSTGRES_USER=postqron

# Password di sviluppo, valida solo in locale. Obbligatoria: senza, il
# container si rifiuta di partire.
POSTGRES_PASSWORD=postqron_local_dev

# Porta esposta sull'host (solo 127.0.0.1). Cambiala se hai già un PostgreSQL
# sulla 5432.
POSTGRES_PORT=5432

# Stringa di connessione usata da API e migrazioni. Deve restare coerente con
# le variabili qui sopra. `sslmode=disable` vale solo in locale: in produzione
# API e database stanno sulla stessa VPS ma la connessione resta cifrata.
DATABASE_URL=postgres://postqron:postqron_local_dev@127.0.0.1:5432/postqron?sslmode=disable
