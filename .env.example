# PostQron — modello di configurazione per lo sviluppo locale.
#
# Copia questo file in `.env` (ignorato da git) e adatta i valori:
#
#     cp .env.example .env
#
# Questo file è VERSIONATO: non inserirci mai credenziali reali. I segreti di
# produzione non stanno nel repository (SPEC §5).

# ------------------------------------------------------------------ database
#
# FONTE DI VERITÀ UNICA. La connessione al database è descritta dalle sole
# variabili POSTGRES_* qui sotto. API e tool di migrazione compongono da queste
# il proprio DSN; Docker Compose legge le stesse variabili per creare e pubblicare
# il container. Un solo posto da cambiare, nessuna copia che possa divergere.
#
# NON aggiungere qui un `DATABASE_URL` già formato: sarebbe una seconda copia di
# host, porta, utente e password, libera di sfasarsi dalla prima. Basta spostare
# il container su un'altra porta e dimenticarsi di aggiornare l'URL perché le
# migrazioni finiscano sul PostgreSQL di un altro progetto in ascolto sulla porta
# vecchia — silenziosamente, se le credenziali combaciano.
#
# Nemmeno interpolare (`DATABASE_URL=postgres://...@${POSTGRES_PORT}/...`) è una
# soluzione: Docker Compose espande `${...}` quando legge il file, un client Go
# che carica lo stesso `.env` in genere no. Lo stesso file significherebbe due
# cose diverse a seconda di chi lo legge, che è peggio della duplicazione.

# Indirizzo su cui il container pubblica il database e su cui l'API lo cerca.
# Resta sul loopback: il database di sviluppo non va esposto in rete.
POSTGRES_HOST=127.0.0.1

# Porta sull'host. Cambiala se hai già un PostgreSQL sulla 5432: è l'unico punto
# da toccare, il resto la eredita.
POSTGRES_PORT=5432

# Nome del database e utente proprietario, creati al primo avvio del container.
# Cambiarli dopo il primo `make db-up` non ha effetto: initdb gira una sola
# volta, per ripartire da zero serve `docker compose down -v`.
POSTGRES_DB=postqron
POSTGRES_USER=postqron

# Password di sviluppo, valida solo in locale. Obbligatoria: senza, il container
# si rifiuta di partire.
POSTGRES_PASSWORD=postqron_local_dev

# In locale la connessione è in chiaro sul loopback. In produzione API e database
# stanno sulla stessa VPS, ma la connessione resta cifrata.
POSTGRES_SSLMODE=disable
