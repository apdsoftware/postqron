# PostQron — modello di configurazione per lo sviluppo locale.
#
# Copia questo file in `.env` (ignorato da git) e adatta i valori:
#
#     cp .env.example .env
#
# Questo file è VERSIONATO: non inserirci mai credenziali reali. I segreti di
# produzione non stanno nel repository (SPEC §5).

# ------------------------------------------------------------------ database
#
# FONTE DI VERITÀ UNICA. La connessione al database è descritta dalle sole
# variabili POSTGRES_* qui sotto. API e tool di migrazione compongono da queste
# il proprio DSN; Docker Compose legge le stesse variabili per creare e pubblicare
# il container. Un solo posto da cambiare, nessuna copia che possa divergere.
#
# NON aggiungere qui un `DATABASE_URL` già formato: sarebbe una seconda copia di
# host, porta, utente e password, libera di sfasarsi dalla prima. Basta spostare
# il container su un'altra porta e dimenticarsi di aggiornare l'URL perché le
# migrazioni finiscano sul PostgreSQL di un altro progetto in ascolto sulla porta
# vecchia — silenziosamente, se le credenziali combaciano.
#
# Nemmeno interpolare (`DATABASE_URL=postgres://...@${POSTGRES_PORT}/...`) è una
# soluzione: Docker Compose espande `${...}` quando legge il file, un client Go
# che carica lo stesso `.env` in genere no. Lo stesso file significherebbe due
# cose diverse a seconda di chi lo legge, che è peggio della duplicazione.

# Indirizzo su cui il container pubblica il database e su cui l'API lo cerca.
# Resta sul loopback: il database di sviluppo non va esposto in rete.
POSTGRES_HOST=127.0.0.1

# Porta sull'host. Cambiala se hai già un PostgreSQL sulla 5432: è l'unico punto
# da toccare, il resto la eredita.
POSTGRES_PORT=5432

# Nome del database e utente proprietario, creati al primo avvio del container.
# Cambiarli dopo il primo `make db-up` non ha effetto: initdb gira una sola
# volta, per ripartire da zero serve `docker compose down -v`.
POSTGRES_DB=postqron
POSTGRES_USER=postqron

# Password di sviluppo, valida solo in locale. Obbligatoria: senza, il container
# si rifiuta di partire.
POSTGRES_PASSWORD=postqron_local_dev

# In locale la connessione è in chiaro sul loopback. In produzione API e database
# stanno sulla stessa VPS, ma la connessione resta cifrata.
POSTGRES_SSLMODE=disable

# Le variabili qui sotto sono applicative: le legge il backend Go, oppure le
# incorporano i frontend al momento della build. Quelle marcate «issue futura»
# non sono ancora lette da alcun componente, e sono elencate per rendere
# esplicito il contratto di configurazione. I nomi dei servizi di terze parti
# seguono docs/CREDENTIALS.md, che è la fonte di verità sul reperimento.

# ---------------------------------------------------------------- backend Go

# Ambiente di esecuzione: development | staging | production.
POSTQRON_ENV=development

# Indirizzo di ascolto dell'API, in forma host:porta.
POSTQRON_HTTP_ADDR=:8080

# Livello dei log strutturati: debug | info | warn | error.
POSTQRON_LOG_LEVEL=info

# Tempo massimo concesso alle richieste in corso durante l'arresto graceful.
POSTQRON_SHUTDOWN_TIMEOUT=15s

# Origin ammesse dal CORS, separate da virgola.
POSTQRON_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ---------------------------------------------------------------- frontend

# Attenzione: i valori NUXT_PUBLIC_* sono incorporati nel bundle al momento
# della build. Su Cloudflare Pages vanno impostati come variabili di build del
# progetto, non a deploy avvenuto (vedi infra/README.md).

# Origin del backend Go, l'unica origin dinamica del prodotto.
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Origin pubblica del sito, usata per gli URL canonici.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------- segreti generati da noi (issue future)
#
# Generane uno per riga con: openssl rand -base64 32
#
# ENCRYPTION_KEY non è rigenerabile: perderla rende illeggibili tutte le chiavi
# AI salvate. Conservala anche fuori dalla VPS (CREDENTIALS.md §6).

# Cifratura a riposo delle chiavi AI degli utenti (R18).
ENCRYPTION_KEY=

# Firma delle sessioni utente (R14).
SESSION_SECRET=

# ---------------------------------------------------------------- Paddle (issue future)
#
# Merchant of Record: gestisce IVA e fatturazione (R16, R17).
# Il codice referenzia i price_id, non i prezzi (CREDENTIALS.md §1).

PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PRO_MONTHLY=
PADDLE_PRICE_PRO_YEARLY=
PADDLE_PRICE_TEAM_MONTHLY=
PADDLE_PRICE_AGENCY_MONTHLY=

# ---------------------------------------------------------------- Mailronix (issue future)
#
# Solo motore di recapito: l'HTML lo compila il backend Go (R20).

MAILRONIX_API_KEY=
MAILRONIX_API_URL=
MAILRONIX_FROM_EMAIL=noreply@postqron.com
MAILRONIX_FROM_NAME=PostQron

# ---------------------------------------------------------------- GitHub App (issue future)
#
# Sync di cron.yaml (R11–R13). Serve una GitHub App, non un personal access
# token: l'utente la installa sui propri repository.

GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=/etc/postqron/github-app.pem

# ---------------------------------------------------------------- provisioning (issue future)
#
# Usate dagli strumenti di infra (E10), non dal processo API a runtime.
# Non vanno mai deployate sulla VPS insieme all'applicazione.

HCLOUD_TOKEN=
HETZNER_SSH_KEY_NAME=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
