{
  "name": "@postqron/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Sito pubblico postqron.com — Nuxt 3 a build statica",
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev --port 3000",
    "generate": "nuxt generate",
    "postgenerate": "find .output -mindepth 1 -maxdepth 1 ! -name public -delete",
    "preview": "nuxt preview",
    "lint": "nuxt prepare && eslint .",
    "format": "nuxt prepare && eslint . --fix",
    "typecheck": "nuxt typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "marked": "^18.0.9",
    "nuxt": "^3.21.11",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  }
}
