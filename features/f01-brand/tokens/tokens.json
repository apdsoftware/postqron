    "content": { "$type": "dimension", "$value": "72rem" },
    "contentWide": { "$type": "dimension", "$value": "90rem" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "0.375rem" },
    "md": { "$type": "dimension", "$value": "0.625rem" },
    "lg": { "$type": "dimension", "$value": "1rem" },
    "xl": { "$type": "dimension", "$value": "1.5rem" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "border": {
    "thin": { "$type": "dimension", "$value": "1px" },
    "thick": { "$type": "dimension", "$value": "2px" },
    "focus": { "$type": "dimension", "$value": "3px" }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": { "color": "#0d181314", "offsetX": "0", "offsetY": "1px", "blur": "2px", "spread": "0" } },
    "md": { "$type": "shadow", "$value": { "color": "#0d18131f", "offsetX": "0", "offsetY": "8px", "blur": "24px", "spread": "-8px" } },
    "lg": { "$type": "shadow", "$value": { "color": "#0d181329", "offsetX": "0", "offsetY": "20px", "blur": "48px", "spread": "-16px" } }
  },
  "duration": {
    "instant": { "$type": "duration", "$value": "0ms" },
    "fast": { "$type": "duration", "$value": "120ms" },
    "normal": { "$type": "duration", "$value": "200ms" },
    "slow": { "$type": "duration", "$value": "320ms" }
  },
  "easing": {
    "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
    "exit": { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] }
  },
