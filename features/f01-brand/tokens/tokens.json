      "heading": { "$type": "number", "$value": 1.2 },
      "body": { "$type": "number", "$value": 1.6 }
    },
    "letterSpacing": {
      "tight": { "$type": "dimension", "$value": "-0.025em" },
      "normal": { "$type": "dimension", "$value": "0" },
      "wide": { "$type": "dimension", "$value": "0.06em" }
    }
  },
  "space": {
