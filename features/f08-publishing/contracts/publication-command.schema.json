{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postqron.local/contracts/f08/publication-command.schema.json",
  "title": "Publication command accepted from F7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "workspace_id",
    "post_id",
    "draft_id",
    "generation",
    "execute_at_utc",
    "state",
    "invalidation_key",
    "destinations"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "workspace_id": { "type": "string", "minLength": 1 },
    "post_id": { "type": "string", "minLength": 1 },
    "draft_id": { "type": "string", "minLength": 1 },
    "generation": { "type": "integer", "minimum": 1 },
    "execute_at_utc": { "type": "string", "format": "date-time" },
    "state": { "const": "pending" },
    "invalidation_key": { "type": "string", "minLength": 1 },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "provider",
          "mode",
          "draft_revision",
          "capability_id",
          "capability_version",
          "payload"
        ],
        "properties": {
          "channel_id": { "type": "string", "minLength": 1 },
          "provider": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "connection_id": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["auto", "notification"] },
          "draft_revision": { "type": "integer", "minimum": 1 },
          "capability_id": { "type": "string", "minLength": 1 },
          "capability_version": { "type": "string", "minLength": 1 },
          "payload": { "type": "object" },
          "max_attempts": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
