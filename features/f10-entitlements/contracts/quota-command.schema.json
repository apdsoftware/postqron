{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postqron.example/contracts/f10/quota-command.schema.json",
  "title": "Server-side quota command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "resource",
    "delta",
    "idempotency_key",
    "occurred_at"
  ],
  "properties": {
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "resource": {
      "type": "string",
      "enum": ["members", "channels", "scheduled_publications"]
    },
    "delta": {
      "type": "integer",
      "not": {
        "const": 0
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
