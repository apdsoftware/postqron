{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postqron.local/contracts/f20/f07-scheduling-command.schema.json",
  "title": "F20SchedulingCommand",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "reservation_id",
    "workspace_id",
    "draft_id",
    "channel_ids",
    "scheduled_at",
    "state",
    "idempotency_key",
    "created_at"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^queuecmd_" },
    "reservation_id": { "type": "string", "pattern": "^reservation_" },
    "workspace_id": { "type": "string", "minLength": 1 },
    "draft_id": { "type": "string", "minLength": 1 },
    "channel_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "scheduled_at": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "starts_at_utc",
        "local_date_time",
        "time_zone",
        "utc_offset_minutes"
      ],
      "properties": {
        "starts_at_utc": { "type": "string", "format": "date-time" },
        "local_date_time": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}$"
        },
        "time_zone": { "type": "string", "minLength": 1 },
        "utc_offset_minutes": { "type": "integer", "minimum": -1080, "maximum": 1080 }
      }
    },
    "state": { "const": "pending" },
    "idempotency_key": { "type": "string", "pattern": "^f20:" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
