{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postqron.example/contracts/f23/push-event.schema.json",
  "title": "Resolved push event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "kind",
    "recipient_account_ids",
    "workspace_id",
    "resource_id",
    "title",
    "body",
    "action_url",
    "occurred_at"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "kind": {
      "enum": [
        "publication_failed",
        "review_requested",
        "review_approved",
        "review_changes_requested"
      ]
    },
    "recipient_account_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 160 }
    },
    "workspace_id": { "type": "string", "minLength": 1 },
    "resource_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "body": { "type": "string", "maxLength": 240 },
    "action_url": {
      "type": "string",
      "pattern": "^/(?!/)",
      "description": "Same-origin relative URL only."
    },
    "occurred_at": { "type": "string", "format": "date-time" }
  }
}
