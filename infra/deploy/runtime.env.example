# Copy to /etc/postqron/runtime.env on the server with mode 0600.
# Populate secret values from the environment secret manager; never commit them.
APP_DOMAIN=staging.example.com
API_DOMAIN=api.staging.example.com
ACME_EMAIL=operations@example.com
WEB_IMAGE=ghcr.io/apdsoftware/postqron-web:sha
API_IMAGE=ghcr.io/apdsoftware/postqron-api:sha
WORKER_IMAGE=ghcr.io/apdsoftware/postqron-worker:sha
POSTGRES_DB=postqron
POSTGRES_USER=postqron
POSTGRES_PASSWORD=replace-from-secret-manager
DATABASE_URL=postgres://postqron:replace-from-secret-manager@postgres:5432/postqron?sslmode=disable
