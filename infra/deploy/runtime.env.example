# Copy to /etc/postqron/runtime.env on the server with mode 0600.
# Populate secret values from the environment secret manager; never commit them.
APP_DOMAIN=staging.example.com
API_DOMAIN=api.staging.example.com
ACME_EMAIL=operations@example.com
WEB_IMAGE=ghcr.io/apdsoftware/postqron-web:sha
API_IMAGE=ghcr.io/apdsoftware/postqron-api:sha
WORKER_IMAGE=ghcr.io/apdsoftware/postqron-worker:sha
POSTGRES_DB=postqron
POSTGRES_USER=postqron
POSTGRES_PASSWORD=replace-from-secret-manager
DATABASE_URL=postgres://postqron:replace-from-secret-manager@postgres:5432/postqron?sslmode=disable
POSTQRON_ADMIN_BOOTSTRAP_EMAIL=carlo.zuffetti@apdsoftware.it
# Base64 of an Argon2id PHC string generated locally with:
# go run ./features/f03-auth/cmd/password-hash --base64
POSTQRON_ADMIN_PASSWORD_HASH_B64=replace-from-secret-manager
# Shared 32-byte AES-GCM key used by Auth for provider-state/session secrets.
# Rotate by deploying a new value only after expiring outstanding OAuth flows.
POSTQRON_AUTH_ENCRYPTION_KEY_B64=replace-from-secret-manager
# Comma-separated HTTPS origins allowed to use browser auth mutations.
POSTQRON_AUTH_ALLOWED_ORIGINS=https://staging.example.com
# Optional OAuth providers. Missing or invalid provider config never blocks password auth.
POSTQRON_AUTH_GOOGLE_CLIENT_ID=
POSTQRON_AUTH_GOOGLE_CLIENT_SECRET=
POSTQRON_AUTH_GOOGLE_REDIRECT_URL=https://staging.example.com/api/v1/auth/callback
POSTQRON_AUTH_APPLE_CLIENT_ID=
# Rotate the Apple client secret before expiry and overlap deployments to avoid callback outages.
POSTQRON_AUTH_APPLE_CLIENT_SECRET=
POSTQRON_AUTH_APPLE_REDIRECT_URL=https://staging.example.com/api/v1/auth/callback
POSTQRON_AUTH_FACEBOOK_CLIENT_ID=
POSTQRON_AUTH_FACEBOOK_CLIENT_SECRET=
POSTQRON_AUTH_FACEBOOK_GRAPH_VERSION=v24.0
POSTQRON_AUTH_FACEBOOK_REDIRECT_URL=https://staging.example.com/api/v1/auth/callback
POSTQRON_AUTH_LINKEDIN_CLIENT_ID=
POSTQRON_AUTH_LINKEDIN_CLIENT_SECRET=
POSTQRON_AUTH_LINKEDIN_REDIRECT_URL=https://staging.example.com/api/v1/auth/callback
# Private export storage shared only by API and worker. Keep it outside web roots.
POSTQRON_PRIVACY_ARTIFACT_DIR=/var/lib/postqron/privacy-exports
POSTQRON_PRIVACY_DOWNLOAD_BASE_URL=https://api.staging.example.com
# Optional Mailronix production sender. Leave unset in local/dev to force FakeSender.
POSTQRON_MAILRONIX_ENDPOINT=https://api.mailronix.com/email/send
POSTQRON_MAILRONIX_API_KEY_SECRET_NAME=MAILRONIX_TRANSACTIONAL_API_KEY
MAILRONIX_TRANSACTIONAL_API_KEY=replace-from-secret-manager
POSTQRON_MAILRONIX_SENDER_EMAIL=help@postqron.com
POSTQRON_MAILRONIX_DOMAIN_VERIFIED=true
