{
  "name": "postqron",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SaaS developer-first per gestione, sincronizzazione e monitoraggio di cronjob",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently --names api,web,dash --prefix-colors blue,green,magenta --kill-others-on-fail \"pnpm run dev:api\" \"pnpm run dev:web\" \"pnpm run dev:dashboard\"",
    "dev:api": "cd services/api && go run ./cmd/api",
    "dev:web": "pnpm --filter @postqron/web run dev",
    "dev:dashboard": "pnpm --filter @postqron/dashboard run dev",
    "generate": "pnpm -r run generate",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "format": "prettier --write . && pnpm -r --if-present run format"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
